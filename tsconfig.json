{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "web/src",
    "outDir": "web/static/js",
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "sourceMap": false,
    "types": []
  },
  "include": ["web/src/**/*.ts"]
}
